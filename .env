# Choose a provider: "ollama" (free, local) | "gemini" (free cloud) | "openai" (paid cloud)
LLM_PROVIDER=gemini

# Used when LLM_PROVIDER=ollama (any locally pulled model name)
OLLAMA_MODEL=llama3

# Used when LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your-gemini-api-key-here

# Used when LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-openai-api-key-here
